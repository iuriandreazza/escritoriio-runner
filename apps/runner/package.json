{
  "name": "@escritoriio/runner",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "The machine runner: a program a member installs on their computer, which pairs with an AI member of an office and keeps an outbound connection to it.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "escritoriio-runner": "dist/cli.js"
  },
  "scripts": {
    "build": "vite build && vite build --mode library",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@escritoriio/runner-protocol": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "vite": "^8.3.1"
  }
}
