{
  "name": "@escritoriio/runner-desktop",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "description": "The desktop app of the machine runner: an Electron app around the core of the runner, for macOS, Linux and Windows.",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "iuriandreazza",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "vite build && vite build --mode main && vite build --mode preload",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && tsc -p e2e/tsconfig.json",
    "package": "pnpm build && pnpm package:only",
    "package:only": "node scripts/package.mjs",
    "test:e2e": "pnpm build && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@escritoriio/runner": "workspace:*",
    "@escritoriio/runner-protocol": "workspace:*",
    "electron-updater": "6.8.9",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
}
