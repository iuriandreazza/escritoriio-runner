<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- What Electron needs to start under the hardened runtime: the JIT of V8 and the memory it runs from. Nothing else is asked for: no environment variables for
       the dynamic linker (which would let a program that starts the app give it a library to load), no unsigned libraries, no debugger. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
